import typing, abc
from PalmSens.Sdk.Data.Models.Domain.Values import CurrentRange, MeasuringRange, ReadingStatus, TimingStatus, AxisDataTypeVariant, DataValueTypeVariant, PotentialRange
from PalmSens import CurrentRange, CurrentRanges, Method, PotentialRange, PotentialRanges
from PalmSens.Comm import ReadingStatus, TimingStatus
from PalmSens.Sdk.Data.Models.Entities.Method import Unit
from PalmSens.Sdk.Data.Models.Domain import CustomUnit, DataValueType
from PalmSens.Data import DataArrayType
from PalmSens.Sdk.Data.Models.Entities import AxisDataType

class CurrentRangeExtensions(abc.ABC):
    @staticmethod
    def FromLegacyCurrentRange(currentRange: CurrentRange) -> CurrentRange: ...
    @staticmethod
    def FromLegacyCurrentRanges(legacyCurrentRange: CurrentRanges) -> CurrentRange: ...
    @staticmethod
    def ToLegacyCurrentRange(domainCurrentRange: CurrentRange) -> CurrentRange: ...
    @staticmethod
    def ToLegacyCurrentRanges(domainCurrentRange: CurrentRange) -> CurrentRanges: ...
    @staticmethod
    def ToMeasuringRange(measuredCurrentRange: CurrentRange) -> MeasuringRange: ...


class DataValueExtensions(abc.ABC):
    @staticmethod
    def ToDomainReadingStatus(legacyReadingStatus: ReadingStatus) -> ReadingStatus: ...
    @staticmethod
    def ToDomainTimingStatus(legacyTimingStatus: TimingStatus) -> TimingStatus: ...


class DataValueTypeVariantExtensions(abc.ABC):
    @staticmethod
    def ConvertToAxisDataType(dataValueTypeVariant: DataValueTypeVariant) -> AxisDataTypeVariant: ...
    @staticmethod
    def GetAssociatedRange(dataValueTypeVariant: DataValueTypeVariant, includeForwardReverseRanges: bool) -> typing.Optional[DataValueTypeVariant]: ...
    @staticmethod
    def GetAssociatedReadingStatus(dataValueTypeVariant: DataValueTypeVariant) -> typing.Optional[DataValueTypeVariant]: ...
    @staticmethod
    def GetAssociatedUnit(dataValueTypeVariant: DataValueTypeVariant, customUnit: CustomUnit = ...) -> Unit: ...
    @staticmethod
    def GetAssociatedUnitScaleFactor(dataValueTypeVariant: DataValueTypeVariant) -> float: ...
    @staticmethod
    def IsApplied(dataValueTypeVariant: DataValueTypeVariant) -> bool: ...
    @staticmethod
    def IsGenerated(dataValueTypeVariant: DataValueTypeVariant) -> bool: ...
    @staticmethod
    def ToDataValueTypeVariant(dataArrayType: DataArrayType, method: Method) -> DataValueTypeVariant: ...
    @staticmethod
    def ToValueType(dataValueTypeVariant: DataValueTypeVariant) -> typing.Type[typing.Any]: ...
    @staticmethod
    def TryConvertToAxisDataType(dataValueTypeVariant: DataValueTypeVariant) -> typing.Optional[AxisDataTypeVariant]: ...


class MeasuringRangeExtensions(abc.ABC):
    @staticmethod
    def ToCurrentRange(measuringRange: MeasuringRange) -> CurrentRange: ...
    @staticmethod
    def ToPotentialRange(measuringRange: MeasuringRange) -> PotentialRange: ...


class OldDataValueTypeExtensions(abc.ABC):
    @staticmethod
    def ConvertToAxisDataType(dataValueType: DataValueType) -> AxisDataType: ...
    @staticmethod
    def GetAssociatedUnit(dataValueType: DataValueType) -> Unit: ...
    @staticmethod
    def Matches(dataValueType: DataValueType, axisDataType: AxisDataType) -> bool: ...
    @staticmethod
    def TryConvertToAxisDataType(dataValueType: DataValueType) -> AxisDataType: ...


class PotentialRangeExtensions(abc.ABC):
    @staticmethod
    def FromLegacyPotentialRange(potentialRange: PotentialRange) -> PotentialRange: ...
    @staticmethod
    def FromLegacyPotentialRanges(legacyPotentialRange: PotentialRanges) -> PotentialRange: ...
    @staticmethod
    def ToLegacyPotentialRange(domainPotentialRange: PotentialRange) -> PotentialRange: ...
    @staticmethod
    def ToLegacyPotentialRanges(domainPotentialRange: PotentialRange) -> PotentialRanges: ...
    @staticmethod
    def ToMeasuringRange(measuredCurrentRange: PotentialRange) -> MeasuringRange: ...
