import typing, clr
from System import IEquatable_1

class MethodParameter(IEquatable_1[MethodParameter]):
    def __init__(self, Key: str, Value: str) -> None: ...
    @property
    def Key(self) -> str: ...
    @Key.setter
    def Key(self, value: str) -> str: ...
    @property
    def Value(self) -> str: ...
    @Value.setter
    def Value(self, value: str) -> str: ...
    def Deconstruct(self, Key: clr.Reference[str], Value: clr.Reference[str]) -> None: ...
    def GetHashCode(self) -> int: ...
    def __eq__(self, left: MethodParameter, right: MethodParameter) -> bool: ...
    def __ne__(self, left: MethodParameter, right: MethodParameter) -> bool: ...
    def ToString(self) -> str: ...
    # Skipped Equals due to it being static, abstract and generic.

    Equals : Equals_MethodGroup
    class Equals_MethodGroup:
        @typing.overload
        def __call__(self, other: MethodParameter) -> bool:...
        @typing.overload
        def __call__(self, obj: typing.Any) -> bool:...
